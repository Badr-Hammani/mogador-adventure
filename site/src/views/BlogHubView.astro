---
import { t, type Lang } from "../lib/i18n";
import { pathFor } from "../lib/routes";
import { postsFor, formatDate } from "../data/blog";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import { variant } from "../lib/photos";
import { ACTIVITY_META } from "../data/activities";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const posts = postsFor(lang).sort(
  (a, b) => new Date(b.post.date).getTime() - new Date(a.post.date).getTime(),
);
---

<div class="container">
  <PageHeader
    kicker={s.blog_kicker}
    title={s.blog_title}
    intro={s.blog_sub}
    centered
  />
</div>

<div class="container posts-grid">
  {
    posts.map(({ post, copy }) => {
      const href = pathFor("blogPost", lang, { post: copy.slug });
      return (
        <article class="post-card">
          <a href={href} class="post-media" tabindex="-1" aria-hidden="true">
            <Photo
              src={variant(post.photo, "wide")}
              alt={copy.title}
              ratio="16-10"
              icon={ACTIVITY_META[post.relatedActivity].icon}
              sizes="(max-width: 760px) 100vw, 360px"
              widths={[360, 720]}
            />
          </a>
          <div class="post-body">
            <p class="post-meta">
              {copy.category} · {formatDate(post.date, lang)}
            </p>
            <h2 class="post-title">
              <a href={href} class="post-link">
                {copy.title}
              </a>
            </h2>
            <p class="post-excerpt">{copy.excerpt}</p>
            <span class="link-arrow">
              {s.blog_read} <span class="arrow-glyph">→</span>
            </span>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--s4);
    padding-block: var(--s3) var(--s9);
  }

  .post-card {
    background: var(--surface);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-panel);
  }

  .post-media :global(.photo-frame) {
    border-radius: 0;
  }

  .post-body {
    padding: var(--s4);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    flex: 1;
  }

  .post-meta {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-dark);
    font-weight: 700;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.3;
  }

  .post-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-excerpt {
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.8;
    flex: 1;
  }
</style>
