---
import { t, type Lang } from "../lib/i18n";
import { pathFor, type QuadVariantKey } from "../lib/routes";
import { waLink } from "../lib/site";
import { activityCopy } from "../data/activities";
import { PRICING } from "../data/pricing";
import {
  quadVariantCopy,
  QUAD_VARIANT_ORDER,
  QUAD_VARIANT_PHOTOS,
} from "../data/quad-variants";
import PriceTable from "../components/PriceTable.astro";
import CTABand from "../components/CTABand.astro";
import TrustBar from "../components/TrustBar.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";

interface Props {
  variant: QuadVariantKey;
  lang: Lang;
}

const { variant, lang } = Astro.props;
const s = t(lang);
const copy = quadVariantCopy(variant, lang);
const quad = activityCopy("quad", lang);
const allOptions = PRICING.quad ?? [];

/* Pages about one specific duration show just that row; the prices page
   and the location page show the full table. */
const options = copy.priceKey
  ? allOptions.filter((o) => o.key === copy.priceKey)
  : allOptions;

const prefixes: Record<Lang, string> = {
  en: "Hi Mogador Adventures! I'd like to book",
  fr: "Bonjour Mogador Adventures ! Je souhaite réserver",
  es: "¡Hola Mogador Adventures! Me gustaría reservar",
  de: "Hallo Mogador Adventures! Ich möchte gern buchen",
  ar: "مرحباً Mogador Adventures! أودّ حجز",
};
const bookMessage = `${prefixes[lang]}: ${quad.name} — ${copy.label}.`;

const siblings = QUAD_VARIANT_ORDER.filter((key) => key !== variant);
const parentHref = pathFor("activity", lang, { activity: "quad" });
---

<article>
  <header class="container variant-head">
    <h1 class="h1-page">{copy.h1}</h1>
    <p class="lead variant-intro">{copy.intro}</p>
    <div class="variant-actions">
      <a
        href={waLink(bookMessage)}
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
        data-context={`quad-${variant}`}
      >
        {s.cta_book}
      </a>
      <a href={parentHref} class="btn btn-outline btn-sm">
        {quad.name}
      </a>
    </div>
  </header>

  <div class="container">
    <Photo
      src={QUAD_VARIANT_PHOTOS[variant]}
      alt={`${quad.name} — ${copy.label}, Essaouira`}
      ratio="16-10"
      icon="quad"
      eager
      widths={[600, 1000, 1400]}
      sizes="(max-width: 1180px) 100vw, 1130px"
    />
  </div>

  <div class="container variant-body">
    <div>
      {copy.body.map((para) => <p class="body-text">{para}</p>)}

      {
        copy.facts && (
          <dl class="facts">
            {copy.facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <nav class="silo" aria-label={quad.name}>
        {
          siblings.map((key) => (
            <a href={pathFor("quadVariant", lang, { variant: key })} class="silo-chip">
              {quadVariantCopy(key, lang).label}
              <span class="arrow-glyph">→</span>
            </a>
          ))
        }
      </nav>
    </div>

    <aside class="variant-side">
      {
        options.length > 0 && (
          <PriceTable lang={lang} options={options} activityName={quad.name} />
        )
      }
      <div class="trust-card">
        <TrustBar lang={lang} compact />
      </div>
      <a href={parentHref} class="back-link">
        <Icon name="arrow" size={15} stroke={2.4} class="arrow-glyph" />
        {quad.name}
      </a>
    </aside>
  </div>
</article>

<CTABand lang={lang} context={`${quad.name} — ${copy.label}`} />

<style>
  .variant-head {
    padding-block: var(--s7) var(--s5);
    max-width: 820px;
  }

  .variant-intro {
    margin-block-start: var(--s3);
  }

  .variant-actions {
    display: flex;
    gap: var(--s2);
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: var(--s5);
  }

  .variant-body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--s7);
    align-items: start;
    padding-block: var(--s7);
  }

  .variant-side {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .trust-card {
    background: var(--surface);
    border-radius: var(--r-card);
    padding: var(--s4);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-dark);
  }
  .back-link:hover {
    text-decoration: underline;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s3);
    margin-block-start: var(--s6);
  }

  .fact {
    background: var(--surface);
    border-radius: var(--r-tag);
    padding: var(--s3);
  }
  .fact dt {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
    font-weight: 700;
  }
  .fact dd {
    margin: 5px 0 0;
    font-size: 14px;
    font-weight: 600;
  }

  .silo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-block-start: var(--s7);
    padding-block-start: var(--s5);
    border-top: 1px solid var(--border-light);
  }

  .silo-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--accent-tint);
    color: var(--accent-dark);
    font-size: 13px;
    font-weight: 600;
    padding: 9px var(--s3);
    border-radius: var(--r-pill);
  }
  .silo-chip:hover {
    background: #ffe4d4;
  }

  @media (max-width: 900px) {
    .variant-body {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
    .variant-side {
      position: static;
    }
  }
</style>
