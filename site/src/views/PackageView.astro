---
import { t, type Lang } from "../lib/i18n";
import { pathFor, type PackageKey } from "../lib/routes";
import { waLink, money } from "../lib/site";
import { PACKAGE_META, packageCopy } from "../data/packages";
import { PACKAGE_PRICING } from "../data/pricing";
import { ACTIVITY_META, activityCopy } from "../data/activities";
import Photo from "../components/Photo.astro";
import CTABand from "../components/CTABand.astro";
import TrustBar from "../components/TrustBar.astro";
import Icon from "../components/Icon.astro";

interface Props {
  pkg: PackageKey;
  lang: Lang;
}

const { pkg, lang } = Astro.props;
const s = t(lang);
const copy = packageCopy(pkg, lang);
const meta = PACKAGE_META[pkg];
const price = PACKAGE_PRICING[pkg];

const prefixes: Record<Lang, string> = {
  en: "Hi Mogador Adventures! I'd like to book",
  fr: "Bonjour Mogador Adventures ! Je souhaite réserver",
  es: "¡Hola Mogador Adventures! Me gustaría reservar",
  de: "Hallo Mogador Adventures! Ich möchte gern buchen",
  ar: "مرحباً Mogador Adventures! أودّ حجز",
};

const labels: Record<Lang, { itinerary: string; includes: string; activities: string }> = {
  en: { itinerary: "How the day runs", includes: "What's included", activities: "Activities in this package" },
  fr: { itinerary: "Le déroulé", includes: "Ce qui est inclus", activities: "Les activités du forfait" },
  es: { itinerary: "Cómo transcurre el día", includes: "Qué incluye", activities: "Actividades del paquete" },
  de: { itinerary: "Ablauf", includes: "Inklusive", activities: "Aktivitäten in diesem Paket" },
  ar: { itinerary: "سير اليوم", includes: "ما يشمله", activities: "أنشطة هذا العرض" },
};
const l = labels[lang];
const heroPhoto = ACTIVITY_META[meta.activities[0]].photo;
---

<article>
  <header class="container package-head">
    <div class="package-icons" aria-hidden="true">
      {
        meta.activities.map((a) => (
          <span class="icon-badge">
            <Icon name={ACTIVITY_META[a].icon} size={22} />
          </span>
        ))
      }
    </div>
    <h1 class="h1-page">{copy.h1}</h1>
    <p class="lead package-intro">{copy.intro}</p>
    <div class="package-actions">
      <a
        href={waLink(`${prefixes[lang]}: ${copy.name}.`)}
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
        data-context={`package-${pkg}`}
      >
        {s.cta_book}
      </a>
      <span class="head-price">
        <strong>{money(price.price)}</strong>
        <s>{money(price.wasPrice)}</s>
        <small>{price.label[lang]} · {s.per_person}</small>
      </span>
    </div>
  </header>

  <div class="container">
    <Photo
      src={heroPhoto}
      alt={copy.name}
      ratio="16-10"
      icon={ACTIVITY_META[meta.activities[0]].icon}
      eager
      widths={[600, 1000, 1400]}
      sizes="(max-width: 1180px) 100vw, 1130px"
    />
  </div>

  <div class="container package-body">
    <div>
      {copy.body.map((para) => <p class="body-text">{para}</p>)}

      <section class="itinerary">
        <h2 class="h2-sm">{l.itinerary}</h2>
        <ol class="itinerary-list">
          {
            copy.itinerary.map((step) => (
              <li>
                <span class="itinerary-time">{step.time}</span>
                <span class="itinerary-text">{step.text}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="activities-links">
        <h2 class="h2-sm">{l.activities}</h2>
        <div class="link-cards">
          {
            meta.activities.map((a) => {
              const ac = activityCopy(a, lang);
              return (
                <a
                  href={pathFor("activity", lang, { activity: a })}
                  class="link-card"
                >
                  <span class="icon-badge icon-badge-sm">
                    <Icon name={ACTIVITY_META[a].icon} size={17} />
                  </span>
                  <span>
                    <strong>{ac.name}</strong>
                    <small>{ac.teaser}</small>
                  </span>
                </a>
              );
            })
          }
        </div>
      </section>
    </div>

    <aside class="package-side">
      <div class="includes-card">
        <h2 class="h3">{l.includes}</h2>
        <ul class="check-list">
          {
            copy.included.map((item) => (
              <li>
                <Icon name="check" size={15} stroke={2.6} />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a
          href={waLink(`${prefixes[lang]}: ${copy.name}.`)}
          target="_blank"
          rel="noopener"
          class="btn btn-primary btn-block book-btn"
          data-context={`package-side-${pkg}`}
        >
          {s.cta_book}
        </a>
      </div>
      <div class="trust-card">
        <TrustBar lang={lang} compact />
      </div>
    </aside>
  </div>
</article>

<CTABand lang={lang} context={copy.name} />

<style>
  .package-head {
    padding-block: var(--s6) var(--s5);
    max-width: 820px;
  }
  .package-icons {
    display: flex;
    gap: var(--s1);
    margin-block-end: var(--s3);
  }
  .package-intro {
    margin-block-start: var(--s3);
  }
  .package-actions {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-wrap: wrap;
    margin-block-start: var(--s5);
  }
  .head-price strong {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--accent-dark);
  }
  .head-price s {
    font-size: 14px;
    opacity: 0.5;
    margin-inline-start: 6px;
  }
  .head-price small {
    display: block;
    font-size: 12px;
    opacity: 0.65;
    margin-block-start: 2px;
  }

  .package-body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--s7);
    align-items: start;
    padding-block: var(--s7);
  }

  .package-side {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .includes-card {
    background: var(--surface-elevated);
    border-radius: var(--r-card);
    padding: var(--s5);
    box-shadow: var(--shadow-card);
  }
  .includes-card .h3 {
    margin-block-end: var(--s3);
  }
  .book-btn {
    margin-block-start: var(--s4);
  }

  .trust-card {
    background: var(--surface);
    border-radius: var(--r-card);
    padding: var(--s4);
  }

  .check-list {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }
  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--s1);
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.85;
  }
  .check-list :global(svg) {
    color: var(--accent-dark);
    flex-shrink: 0;
    margin-block-start: 3px;
  }

  .itinerary {
    margin-block-start: var(--s7);
  }
  .itinerary-list {
    margin-block-start: var(--s4);
    display: flex;
    flex-direction: column;
  }
  .itinerary-list li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: var(--s3);
    padding-block: var(--s2);
    border-bottom: 1px solid var(--border-light);
    align-items: baseline;
  }
  .itinerary-list li:last-child {
    border-bottom: none;
  }
  .itinerary-time {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--accent-dark);
  }
  .itinerary-text {
    font-size: 15px;
    opacity: 0.85;
    line-height: 1.5;
  }

  .activities-links {
    margin-block-start: var(--s7);
  }
  .link-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s2);
    margin-block-start: var(--s4);
  }
  .link-card {
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    background: var(--surface);
    border-radius: var(--r-tag);
    padding: var(--s3);
    transition: background-color 0.15s ease;
  }
  .link-card:hover {
    background: #e2d2b6;
  }
  .link-card strong {
    display: block;
    font-size: 14px;
  }
  .link-card small {
    display: block;
    font-size: 12px;
    opacity: 0.7;
    line-height: 1.45;
    margin-block-start: 3px;
  }

  @media (max-width: 900px) {
    .package-body {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
    .package-side {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .itinerary-list li {
      grid-template-columns: 70px 1fr;
      gap: var(--s2);
    }
  }
</style>
