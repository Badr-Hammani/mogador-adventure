---
import { t, type Lang } from "../lib/i18n";
import { GENERAL_FAQ, faqText } from "../data/content";
import PageHeader from "../components/PageHeader.astro";
import Accordion from "../components/Accordion.astro";
import CTABand from "../components/CTABand.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const items = GENERAL_FAQ.map((entry) => faqText(entry, lang));
---

<div class="container faq-page">
  <PageHeader
    kicker={s.faq_kicker}
    title={s.faq_title}
    intro={s.faq_sub}
    centered
  />
  <div class="faq-wrap">
    <Accordion items={items} />
  </div>
</div>

<CTABand lang={lang} title={s.still_questions} subtitle={s.still_questions_sub} />

<style>
  .faq-page {
    padding-block-end: var(--s8);
  }
  .faq-wrap {
    max-width: 800px;
    margin-inline: auto;
    margin-block-start: var(--s5);
  }
</style>
