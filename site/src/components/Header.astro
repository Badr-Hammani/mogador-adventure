---
import { LANGS, LANG_META, t, type Lang } from "../lib/i18n";
import { pathFor, pageExistsIn, type PageKey } from "../lib/routes";
import { SITE, waLink } from "../lib/site";
import Icon from "./Icon.astro";
import Flag from "./Flag.astro";

interface Props {
  lang: Lang;
  /** Page key of the current page — used to highlight the active nav item. */
  current?: PageKey;
  /**
   * Where the language switcher should send the visitor for each language.
   * Comes from the same alternates that build hreflang, so the switcher and
   * the search engine always agree.
   */
  alternates: { lang: Lang; path: string }[];
}

const { lang, current, alternates } = Astro.props;
const s = t(lang);

const navKeys: PageKey[] = [
  "activities",
  "packages",
  "about",
  "gallery",
  "blog",
  "faq",
];

const navLabels: Record<string, string> = {
  activities: s.nav_activities,
  packages: s.nav_packages,
  about: s.nav_about,
  gallery: s.nav_gallery,
  blog: s.nav_blog,
  faq: s.nav_faq,
};

const navLinks = navKeys
  .filter((key) => pageExistsIn(key, lang))
  .map((key) => ({
    key,
    href: pathFor(key, lang),
    label: navLabels[key],
    active: current === key,
  }));

const altMap = new Map(alternates.map((a) => [a.lang, a.path]));
const bookHref = pathFor("book", lang);
const wa = waLink(
  lang === "fr"
    ? "Bonjour Mogador Adventures ! Je souhaite réserver une aventure."
    : "Hi Mogador Adventures! I'd like to book an adventure.",
);
---

<header class="site-header">
  <div class="header-bar container">
    <a href={pathFor("home", lang)} class="wordmark">{SITE.name}</a>

    <nav class="desktop-nav" aria-label={s.nav_activities}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: link.active }]}
            aria-current={link.active ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/*
      A <details> dropdown rather than a <select>: <option> can't contain an
      SVG flag, and flag emoji don't render on Windows. <details> gives us the
      open/close behaviour natively — keyboard accessible and working with
      JavaScript disabled — and each language is a real link, so the switcher
      is crawlable and middle-click/open-in-new-tab behave normally.
    */}
    <details class="lang-switch" data-lang-switch>
      {
        /*
         * aria-label must contain the visible text for voice-control users
         * ("click EN" only works if "EN" is actually part of the accessible
         * name) — a plain aria-label="Language" with "EN" only in a child
         * span discards the visible label entirely.
         */
      }
      <summary aria-label={`${lang.toUpperCase()} — ${s.lang_label}`}>
        <Flag code={lang} size={18} />
        <span class="lang-code">{lang.toUpperCase()}</span>
        <span class="lang-chevron" aria-hidden="true">
          <Icon name="chevron" size={14} stroke={2.4} />
        </span>
      </summary>
      <ul class="lang-menu">
        {
          LANGS.map((code) => {
            const target = altMap.get(code);
            if (!target) return null;
            return (
              <li>
                <a
                  href={target}
                  hreflang={LANG_META[code].htmlLang}
                  lang={LANG_META[code].htmlLang}
                  class:list={["lang-option", { current: code === lang }]}
                  aria-current={code === lang ? "true" : undefined}
                >
                  <Flag code={code} size={18} />
                  <span>{LANG_META[code].name}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </details>

    {
      current !== "book" && (
        <a href={bookHref} class="header-cta">
          {s.nav_contact}
        </a>
      )
    }

    <button
      class="hamburger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <Icon name="menu" size={18} stroke={2.5} />
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Menu" hidden>
    <div class="container">
      {
        navLinks.map((link) => (
          <a href={link.href} class:list={["mobile-link", { active: link.active }]}>
            {link.label}
          </a>
        ))
      }
      <a href={bookHref} class="btn btn-primary btn-block mobile-cta">
        {s.nav_contact}
      </a>
      <a href={wa} target="_blank" rel="noopener" class="mobile-wa">
        <Icon name="whatsapp" size={16} />
        {SITE.phone}
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(245, 234, 216, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border-light);
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding-block: var(--s2);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text);
    margin-inline-end: auto;
    white-space: nowrap;
  }

  .desktop-nav {
    display: none;
    gap: var(--s5);
    align-items: center;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-dark);
  }

  .lang-switch {
    position: relative;
    flex-shrink: 0;
  }

  .lang-switch summary {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 5px 10px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .lang-switch summary::-webkit-details-marker {
    display: none;
  }
  .lang-switch summary:hover {
    background: #e2d2b6;
  }

  .lang-chevron {
    display: flex;
    color: var(--accent-dark);
    transition: transform 0.15s ease;
  }
  .lang-switch[open] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 6px);
    z-index: 60;
    min-width: 168px;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-tile);
    box-shadow: var(--shadow-panel);
    padding: 5px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    padding: 8px 10px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .lang-option:hover {
    background: var(--accent-tint);
    color: var(--accent-dark);
  }
  .lang-option.current {
    font-weight: 700;
    color: var(--accent-dark);
    background: var(--accent-tint);
  }

  .header-cta {
    display: none;
    align-items: center;
    /* --accent on --bg text is 3.03:1, under the 4.5:1 minimum — see the
       .btn-primary comment in global.css for the full explanation. */
    background: var(--accent-dark);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 13px;
    padding: var(--s1) var(--s3);
    border-radius: var(--r-pill);
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .header-cta:hover {
    background: var(--accent-hover);
  }

  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border);
    background: transparent;
    flex-shrink: 0;
  }

  .mobile-nav {
    border-top: 1px solid var(--border-light);
    padding-block: var(--s1) var(--s3);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav .container {
    display: flex;
    flex-direction: column;
    gap: 4.4px;
  }

  .mobile-link {
    font-size: 15px;
    font-weight: 600;
    padding-block: var(--s1);
  }
  .mobile-link.active {
    color: var(--accent-dark);
  }

  .mobile-cta {
    margin-block-start: var(--s1);
  }

  .mobile-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    padding-block: var(--s2);
    color: var(--accent-dark);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
    }
    .header-cta {
      display: inline-flex;
    }
    .hamburger {
      display: none;
    }
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const open = panel?.hasAttribute("hidden");
    if (open) {
      panel?.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    } else {
      panel?.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // Language switcher. Each entry is a plain link to the equivalent localised
  // URL — deliberately NOT localStorage + reload, which is why the prototype's
  // four non-English locales would have been invisible to search engines.
  // <details> handles open/close itself; this only adds dismissal.
  const langSwitch = document.querySelector<HTMLDetailsElement>("[data-lang-switch]");

  document.addEventListener("click", (event) => {
    if (!langSwitch?.open) return;
    if (!langSwitch.contains(event.target as Node)) langSwitch.open = false;
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && langSwitch?.open) {
      langSwitch.open = false;
      langSwitch.querySelector("summary")?.focus();
    }
  });
</script>
