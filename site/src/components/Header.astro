---
import { LANGS, LANG_META, t, type Lang } from "../lib/i18n";
import { pathFor, pageExistsIn, type PageKey } from "../lib/routes";
import { SITE, waLink } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
  /** Page key of the current page — used to highlight the active nav item. */
  current?: PageKey;
  /**
   * Where the language switcher should send the visitor for each language.
   * Comes from the same alternates that build hreflang, so the switcher and
   * the search engine always agree.
   */
  alternates: { lang: Lang; path: string }[];
}

const { lang, current, alternates } = Astro.props;
const s = t(lang);

const navKeys: PageKey[] = [
  "activities",
  "packages",
  "about",
  "gallery",
  "blog",
  "faq",
];

const navLabels: Record<string, string> = {
  activities: s.nav_activities,
  packages: s.nav_packages,
  about: s.nav_about,
  gallery: s.nav_gallery,
  blog: s.nav_blog,
  faq: s.nav_faq,
};

const navLinks = navKeys
  .filter((key) => pageExistsIn(key, lang))
  .map((key) => ({
    key,
    href: pathFor(key, lang),
    label: navLabels[key],
    active: current === key,
  }));

const altMap = new Map(alternates.map((a) => [a.lang, a.path]));
const bookHref = pathFor("book", lang);
const wa = waLink(
  lang === "fr"
    ? "Bonjour Mogador Adventures ! Je souhaite réserver une aventure."
    : "Hi Mogador Adventures! I'd like to book an adventure.",
);
---

<header class="site-header">
  <div class="header-bar container">
    <a href={pathFor("home", lang)} class="wordmark">{SITE.name}</a>

    <nav class="desktop-nav" aria-label={s.nav_activities}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: link.active }]}
            aria-current={link.active ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <label class="lang-switch">
      <span class="visually-hidden">{s.lang_label}</span>
      <select data-lang-switch>
        {
          LANGS.map((code) => {
            const target = altMap.get(code);
            return target ? (
              <option value={target} selected={code === lang}>
                {LANG_META[code].name}
              </option>
            ) : null;
          })
        }
      </select>
    </label>

    {
      current !== "book" && (
        <a href={bookHref} class="header-cta">
          {s.nav_contact}
        </a>
      )
    }

    <button
      class="hamburger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <Icon name="menu" size={18} stroke={2.5} />
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Menu" hidden>
    <div class="container">
      {
        navLinks.map((link) => (
          <a href={link.href} class:list={["mobile-link", { active: link.active }]}>
            {link.label}
          </a>
        ))
      }
      <a href={bookHref} class="btn btn-primary btn-block mobile-cta">
        {s.nav_contact}
      </a>
      <a href={wa} target="_blank" rel="noopener" class="mobile-wa">
        <Icon name="whatsapp" size={16} />
        {SITE.phone}
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(245, 234, 216, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border-light);
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding-block: var(--s2);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text);
    margin-inline-end: auto;
    white-space: nowrap;
  }

  .desktop-nav {
    display: none;
    gap: var(--s5);
    align-items: center;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-dark);
  }

  .lang-switch select {
    font-family: var(--font-body);
    font-size: 13px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 6px 12px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .header-cta {
    display: none;
    align-items: center;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 13px;
    padding: var(--s1) var(--s3);
    border-radius: var(--r-pill);
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .header-cta:hover {
    background: var(--accent-hover);
  }

  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border);
    background: transparent;
    flex-shrink: 0;
  }

  .mobile-nav {
    border-top: 1px solid var(--border-light);
    padding-block: var(--s1) var(--s3);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav .container {
    display: flex;
    flex-direction: column;
    gap: 4.4px;
  }

  .mobile-link {
    font-size: 15px;
    font-weight: 600;
    padding-block: var(--s1);
  }
  .mobile-link.active {
    color: var(--accent-dark);
  }

  .mobile-cta {
    margin-block-start: var(--s1);
  }

  .mobile-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    padding-block: var(--s2);
    color: var(--accent-dark);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
    }
    .header-cta {
      display: inline-flex;
    }
    .hamburger {
      display: none;
    }
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const open = panel?.hasAttribute("hidden");
    if (open) {
      panel?.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    } else {
      panel?.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // Language switcher: a real navigation to the equivalent localised URL.
  // Deliberately NOT localStorage + reload — search engines have neither, and
  // that pattern is why the prototype's four non-English locales were invisible.
  document
    .querySelector<HTMLSelectElement>("[data-lang-switch]")
    ?.addEventListener("change", (event) => {
      const target = (event.target as HTMLSelectElement).value;
      if (target) window.location.href = target;
    });
</script>
