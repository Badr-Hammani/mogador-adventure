---
import { t, type Lang } from "../lib/i18n";
import { money, waLink } from "../lib/site";
import type { PriceOption } from "../data/pricing";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
  options: PriceOption[];
  /** Activity name, used to pre-fill each row's WhatsApp message. */
  activityName: string;
}

const { lang, options, activityName } = Astro.props;
const s = t(lang);

const prefixes: Record<Lang, string> = {
  en: "Hi Mogador Adventures! I'd like to book",
  fr: "Bonjour Mogador Adventures ! Je souhaite réserver",
  es: "¡Hola Mogador Adventures! Me gustaría reservar",
  de: "Hallo Mogador Adventures! Ich möchte gern buchen",
  ar: "مرحباً Mogador Adventures! أودّ حجز",
};

/* The card prices one quad, for one rider or two sharing. */
const headOne: Record<Lang, string> = {
  en: "1 rider",
  fr: "1 pilote",
  es: "1 piloto",
  de: "1 Fahrer",
  ar: "سائق واحد",
};
const headTwo: Record<Lang, string> = {
  en: "2 sharing",
  fr: "2 partagé",
  es: "2 compartido",
  de: "2 geteilt",
  ar: "شخصان",
};
const popularLabel: Record<Lang, string> = {
  en: "Most booked",
  fr: "Le plus réservé",
  es: "Más reservado",
  de: "Am meisten gebucht",
  ar: "الأكثر حجزاً",
};

const hasSharing = options.some((o) => o.priceTwo);
---

<div class="price-block">
  <h2 class="h2-sm">{s.prices_title}</h2>

  {
    hasSharing && (
      <div class="price-head" aria-hidden="true">
        <span class="ph-dur" />
        <span class="ph-col">{headOne[lang]}</span>
        <span class="ph-col">{headTwo[lang]}</span>
      </div>
    )
  }

  <ul class="price-list">
    {
      options.map((option) => (
        <li class:list={["price-row", { popular: option.popular }]}>
          <div class="price-main">
            <span class="price-duration">
              <Icon name="clock" size={15} stroke={2} />
              {option.label[lang]}
            </span>
            {option.popular && (
              <span class="tag popular-tag">{popularLabel[lang]}</span>
            )}
            {option.route && <span class="price-route">{option.route[lang]}</span>}
          </div>

          <div class="price-figures">
            <span class="price-amount">
              {money(option.price)}
              <small>{headOne[lang]}</small>
            </span>
            {option.priceTwo && (
              <span class="price-amount price-amount-two">
                {money(option.priceTwo)}
                <small>{headTwo[lang]}</small>
              </span>
            )}
          </div>

          <a
            class="btn btn-outline btn-sm price-cta"
            href={waLink(
              `${prefixes[lang]}: ${activityName} — ${option.label[lang]}.`,
            )}
            target="_blank"
            rel="noopener"
            data-context={`price-${option.key}`}
          >
            {s.book_this}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="price-note">{s.prices_note}</p>
</div>

<style>
  .price-block {
    background: var(--surface-elevated);
    border-radius: var(--r-card);
    padding: var(--s5);
    box-shadow: var(--shadow-card);
  }

  .price-head {
    display: none;
  }

  .price-list {
    margin-block: var(--s4) 0;
  }

  .price-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s2) var(--s3);
    align-items: start;
    padding-block: var(--s3);
    border-bottom: 1px solid var(--border-light);
  }
  .price-row:last-child {
    border-bottom: none;
  }

  .price-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }

  .price-duration {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 15px;
    font-weight: 600;
  }

  .price-route {
    font-size: 12.5px;
    line-height: 1.5;
    opacity: 0.7;
    max-width: 42ch;
  }

  .popular-tag {
    background: var(--accent-tint);
    color: var(--accent-dark);
  }

  .price-figures {
    display: flex;
    gap: var(--s3);
    align-items: baseline;
  }

  .price-amount {
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--accent-dark);
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
  }
  .price-amount-two {
    opacity: 0.75;
    font-size: 19px;
  }
  .price-amount small {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.6;
    color: var(--text);
    margin-block-start: 3px;
  }

  .price-cta {
    grid-column: 2;
    justify-self: end;
  }

  .price-note {
    font-size: 13px;
    opacity: 0.7;
    margin-block-start: var(--s4);
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .price-row {
      grid-template-columns: 1fr;
    }
    .price-figures {
      justify-content: flex-start;
    }
    .price-amount {
      align-items: flex-start;
    }
    .price-cta {
      grid-column: 1;
      justify-self: start;
    }
  }
</style>
