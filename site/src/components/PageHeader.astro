---
interface Props {
  kicker?: string;
  title: string;
  intro?: string;
  /** Centre the block (used on hub/index pages). */
  centered?: boolean;
}

const { kicker, title, intro, centered = false } = Astro.props;
---

<header class:list={["page-header", { centered }]}>
  {kicker && <p class="kicker">{kicker}</p>}
  <h1 class="h1-page">{title}</h1>
  {intro && <p class="lead page-intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-block: var(--s8) var(--s5);
  }

  .centered {
    text-align: center;
  }

  .page-intro {
    margin-block-start: var(--s3);
    max-width: 62ch;
  }

  .centered .page-intro {
    margin-inline: auto;
  }
</style>
